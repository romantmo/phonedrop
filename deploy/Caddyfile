# Caddyfile — настройки «привратника» Caddy.
# Caddy сам получает и продлевает бесплатный HTTPS-сертификат Let's Encrypt
# для указанного адреса. Ничего настраивать вручную не нужно.

drop.rbgen.com {
	# Сжимать ответы — страницы грузятся быстрее.
	encode zstd gzip

	# Не принимать слишком большие загрузки (лимит приложения — 500 МБ).
	request_body {
		max_size 520MB
	}

	# Браузер будет всегда открывать сайт только по HTTPS.
	header Strict-Transport-Security "max-age=31536000"

	# Всё остальное — передать приложению (WebSocket тоже работает сам).
	reverse_proxy app:8000
}
